---
/**
 * The single-page home view, shared by "/" (EN) and "/de/" (DE).
 *
 * Structure follows docs/story.md: hero, prologue, four chapters and an
 * epilogue, then the plain, scannable sections (skills, experience, contact).
 */
import monsterImage from '@/assets/images/monster-light-tunnel.jpg';
import Chapter from '@/components/Chapter.astro';
import Hero from '@/components/Hero.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { persianMarkers, site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.story;

// Sections still to be built in Phase 5. They exist now so the nav anchors work.
const upcoming = [
  { id: 'skills', title: t.sections.skills },
  { id: 'experience', title: t.sections.experience },
  { id: 'contact', title: t.sections.contact },
];
---

<BaseLayout lang={lang}>
  <SiteHeader lang={lang} />

  <main id="main">
    <Hero lang={lang} />

    <div id="story">
      <Chapter id="prologue" marker={persianMarkers.prologue} {...s.prologue}>
        {s.prologue.body.map((p) => <p>{p}</p>)}
      </Chapter>

      <Chapter
        id="monster"
        marker={persianMarkers.monster}
        {...s.monster}
        image={monsterImage}
        imageAlt={s.monster.imageAlt}
        imagePosition="24% 50%"
      >
        {s.monster.body.map((p) => <p>{p}</p>)}
      </Chapter>

      <Chapter id="turning-point" marker={persianMarkers.turn} {...s.turn}>
        {s.turn.body.map((p) => <p>{p}</p>)}
        <p>
          {s.turn.proofBefore}<a href={site.repoUrl} target="_blank" rel="noopener noreferrer"
            >{s.turn.proofLink}<span class="sr-only"> {t.a11y.opensInNewTab}</span></a
          >{s.turn.proofAfter}
        </p>
      </Chapter>
    </div>

    <Chapter id="work" marker={persianMarkers.proof} {...s.proof}>
      <p>{s.proof.intro}</p>
      {/* [TODO: Phase 4] Featured project cards and the "More projects" grid go here. */}
      <p class="text-sm text-text-muted">[{t.sections.comingSoon}]</p>
    </Chapter>

    <Chapter id="why" marker={persianMarkers.why} {...s.why}>
      {s.why.body.map((p) => <p>{p}</p>)}
    </Chapter>

    <Chapter id="vienna" marker={persianMarkers.vienna} {...s.vienna}>
      {s.vienna.body.map((p) => <p>{p}</p>)}
    </Chapter>

    {
      upcoming.map((section) => (
        <section
          id={section.id}
          aria-labelledby={`${section.id}-title`}
          class="mx-auto max-w-(--container-content) px-(--spacing-gutter) pt-(--spacing-section)"
        >
          {/* [TODO: Phase 5] Build this section. */}
          <h2 id={`${section.id}-title`} class="border-t border-border pt-6 text-4xl sm:text-5xl">
            {section.title}
          </h2>
          <p class="mt-4 text-sm text-text-muted">[{t.sections.comingSoon}]</p>
        </section>
      ))
    }
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>
