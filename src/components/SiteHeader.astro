---
/**
 * Fixed site header. Transparent over the hero, gains a blurred olive
 * background once the page is scrolled (tiny inline script below).
 * Mobile: links collapse into a native <details> menu, no framework needed.
 */
import LanguageToggle from '@/components/LanguageToggle.astro';
import type { Lang } from '@/i18n/config';
import { localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizePath('/', lang);

// Absolute anchors (/#work, /de/#work) so the nav also works from project pages.
const links = [
  { href: `${home}#story`, label: t.nav.about },
  { href: `${home}#work`, label: t.nav.work },
  { href: `${home}#skills`, label: t.nav.skills },
  { href: `${home}#experience`, label: t.nav.experience },
  { href: `${home}#contact`, label: t.nav.contact },
];
---

<header
  data-site-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-500 data-[scrolled]:border-border data-[scrolled]:bg-bg/80 data-[scrolled]:backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-[90rem] items-center justify-between gap-6 px-(--spacing-gutter) md:h-20">
    <a href={home} aria-label={t.nav.home} class="font-serif text-2xl leading-none md:text-[1.75rem]">
      {t.hero.name}
    </a>

    <nav aria-label={t.a11y.mainNav} class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-text/85 transition-colors hover:text-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-5">
      <LanguageToggle lang={lang} />

      <details data-mobile-menu class="relative md:hidden">
        <summary
          class="flex h-10 cursor-pointer list-none items-center rounded-full border border-border bg-bg/60 px-4 text-sm backdrop-blur-sm [&::-webkit-details-marker]:hidden"
        >
          {t.a11y.menu}
        </summary>
        <nav
          aria-label={t.a11y.mainNav}
          class="absolute top-12 right-0 w-56 rounded-xl border border-border bg-surface p-2 shadow-2xl shadow-black/40"
        >
          <ul>
            {
              links.map((link) => (
                <li>
                  <a href={link.href} class="block rounded-lg px-3 py-2.5 text-text hover:bg-surface-raised">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Header background on scroll.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  // Mobile menu: close after choosing a link, or on Escape.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (menu) {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
